# ─── TAI (atl.taicloud.net) ─────────────────────────────
TAI_USERNAME=your-tai-username
TAI_PASSWORD=your-tai-password
# Account to pull in TAI. 793141 = "CM - Binghamton". App sets this per user selection.
TAI_CUSTOMER_ID=793141
# Invoice Date range to filter on (app-configured). Format: YYYY-MM-DD.
TAI_START_DATE=2026-01-01
TAI_END_DATE=2026-07-01

# ─── CTSI (portal.ctsi-global.com) ──────────────────────
CTSI_USERNAME=your-ctsi-username
CTSI_PASSWORD=your-ctsi-password
# Account/entity selected on CTSI before upload. App sets this per user selection.
CTSI_ACCOUNT=2036
